@model WorkoutPlanDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết Kế hoạch";
}

<section class="page-hero">
    <div>
        <p class="eyebrow">Cấp độ: @Model.Plan.Level</p>
        <h1>@Model.Plan.PlanName</h1>
        <p class="lead">@Model.Plan.Summary</p>
    </div>
    <div class="hero-actions">
        <a class="button" asp-action="AddDay" asp-route-planId="@Model.Plan.PlanID">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Thêm ngày tập
        </a>
        <a class="button button--ghost" asp-action="Edit" asp-route-id="@Model.Plan.PlanID">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            Sửa kế hoạch
        </a>
    </div>
</section>

<section class="metric-grid">
    <article class="metric-card"><span class="metric-card__label">Mục tiêu</span><strong>@Model.Plan.Goal</strong></article>
    <article class="metric-card"><span class="metric-card__label">Thời lượng</span><strong>@Model.Plan.Duration ngày</strong></article>
    <article class="metric-card"><span class="metric-card__label">Số ngày tập</span><strong>@Model.TotalDays ngày</strong></article>
    <article class="metric-card"><span class="metric-card__label">Số bài tập</span><strong>@Model.TotalExercises bài</strong></article>
</section>

<section class="content-grid">
    @foreach (var day in Model.Plan.WorkoutDays.OrderBy(item => item.DayNumber))
    {
        <article class="surface-card js-reveal">
            <div class="card-head">
                <div>
                    <p class="eyebrow">Ngày tập @day.DayNumber</p>
                    <h2>@day.FocusArea</h2>
                </div>
                <div class="actions-row">
                    <form asp-controller="WorkoutLogs" asp-action="LogDay" asp-route-dayId="@day.DayID" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="button">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                            Bắt đầu tập
                        </button>
                    </form>
                    <a class="button button--ghost" asp-action="AddExercise" asp-route-dayId="@day.DayID">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Thêm bài tập
                    </a>
                    <a class="button button--ghost" asp-action="EditDay" asp-route-id="@day.DayID">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        Sửa ngày
                    </a>
                    <form asp-action="DeleteDay" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@day.DayID" />
                        <button type="submit" class="button button--ghost button--danger">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            Xóa ngày
                        </button>
                    </form>
                </div>
            </div>
            <p class="mb-3 text-muted">@day.Note</p>

            @if (day.WorkoutExercises.Any())
            {
                <div class="table-shell mt-4 table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Bài tập</th>
                                <th>Hiệp (Sets)</th>
                                <th>Lặp (Reps)</th>
                                <th>Nghỉ (Rest)</th>
                                <th style="text-align: right;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in day.WorkoutExercises.OrderBy(entry => entry.DisplayOrder))
                            {
                                <tr>
                                    <td><strong>@item.Exercise.Name</strong></td>
                                    <td>@item.Sets hiệp</td>
                                    <td>@item.Reps lần</td>
                                    <td>@item.RestTime giây</td>
                                    <td>
                                        <div class="actions-row" style="justify-content: flex-end;">
                                            <a class="button button--ghost" asp-action="EditExercise" asp-route-id="@item.ID">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                                Sửa
                                            </a>
                                            <form asp-action="DeleteExercise" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.ID" />
                                                <button type="submit" class="button button--ghost button--danger">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                    Xóa
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="empty-state">Ngày tập này chưa có bài tập nào.</p>
            }
        </article>
    }

    @if (!Model.Plan.WorkoutDays.Any())
    {
        <article class="surface-card">
            <p class="empty-state">Kế hoạch này chưa có ngày tập nào.</p>
        </article>
    }
</section>
