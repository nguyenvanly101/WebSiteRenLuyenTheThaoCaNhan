@model User
@{
    ViewData["Title"] = "Xóa người dùng";
}

<section class="surface-card">
    <p class="eyebrow">Quản trị viên</p>
    <h1>Xóa người dùng: @Model.FullName</h1>
    <p class="lead" style="color: var(--orange);">Cảnh báo: Tài khoản này và toàn bộ dữ liệu liên quan (kế hoạch tập, nhật ký tập luyện, mục tiêu) sẽ bị xóa vĩnh viễn khỏi hệ thống.</p>

    <div class="stack-list mt-4">
        <article class="stack-item"><strong>Tên đăng nhập:</strong> @Model.Username</article>
        <article class="stack-item"><strong>Email:</strong> @Model.Email</article>
        <article class="stack-item"><strong>Vai trò:</strong> @Model.Role</article>
    </div>

    <form asp-action="Delete" method="post" class="actions-row mt-4">
        @Html.AntiForgeryToken()
        <button type="submit" class="button button--danger">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            Xác nhận xóa
        </button>
        <a class="button button--ghost" asp-action="Index">Hủy bỏ</a>
    </form>
</section>
