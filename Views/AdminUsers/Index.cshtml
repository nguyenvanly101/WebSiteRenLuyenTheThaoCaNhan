@model IEnumerable<AdminUserListItemViewModel>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<section class="page-hero">
    <div>
        <p class="eyebrow">Quản trị viên</p>
        <h1>Quản lý người dùng và phân quyền</h1>
        <p class="lead">Cập nhật thông tin tài khoản, thay đổi trạng thái hoạt động hoặc phân quyền thành viên trong hệ thống.</p>
    </div>
</section>

<section class="surface-card">
    <div class="table-shell">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Người dùng</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Chỉ số (Plan / Goal / Log)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.User.FullName</strong>
                            <div style="font-size: 0.85rem; color: var(--muted); margin-top: 4px;">@item.User.Username | @item.User.Email</div>
                        </td>
                        <td>
                            @if (item.User.Role == "Admin")
                            {
                                <span class="pill pill--purple">@item.User.Role</span>
                            }
                            else
                            {
                                <span class="pill">@item.User.Role</span>
                            }
                        </td>
                        <td>
                            @if (item.User.IsActive)
                            {
                                <span style="color: var(--lime); display: inline-flex; align-items: center; gap: 6px; font-weight: 600;">
                                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: var(--lime);"></span>
                                    Hoạt động
                                </span>
                            }
                            else
                            {
                                <span style="color: var(--orange); display: inline-flex; align-items: center; gap: 6px; font-weight: 600;">
                                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: var(--orange);"></span>
                                    Đã khóa
                                </span>
                            }
                        </td>
                        <td>
                            <span style="font-weight: 600;">@item.PlanCount</span> kế hoạch / 
                            <span style="font-weight: 600;">@item.GoalCount</span> mục tiêu / 
                            <span style="font-weight: 600;">@item.LogCount</span> buổi tập
                        </td>
                        <td>
                            <div class="actions-row">
                                <a class="button button--ghost" style="min-height: 32px; padding: 0 12px; font-size: 0.8rem;" asp-action="Edit" asp-route-id="@item.User.UserID">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    Sửa
                                </a>
                                <a class="button button--ghost" style="min-height: 32px; padding: 0 12px; font-size: 0.8rem; background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.2); color: #fca5a5;" asp-action="Delete" asp-route-id="@item.User.UserID">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="empty-state mt-4">Chưa có người dùng nào trong hệ thống.</p>
    }
</section>
